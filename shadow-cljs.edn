{:source-paths ["src"]

 :dependencies [[reagent "2.0.1"]
                ;; not 12.0.1: its p/handle and .catch reject after a handler recovers
                ;; (funcool/promesa#171, #172) — exercise.cljs queues runs on p/handle
                [funcool/promesa "11.0.678"]
                [metosin/malli "0.20.3"]]

 :jvm-opts ["--sun-misc-unsafe-memory-access=allow"]

 :dev-http {8291 "public"}

 :builds
 {:app {:target :browser
        :output-dir "public/js"
        :asset-path "/js"
        :modules {:main {:init-fn loretile.core/init}}}
  :test {:target :node-test
         :output-to "out/test.js"
         :ns-regexp "-test$"}
  ;; the fold and the guard inside the graph-store Worker (wiki/Graph-Store.md):
  ;; an ES module public/js/graphstore.js imports beside SQLite
  :graphfold {:target :esm
              :output-dir "public/js/graphfold"
              :modules {:graphfold {:exports {judge loretile.graph-worker/judge changes loretile.graph-worker/changes}}}}
  ;; the MCP server for coding agents (wiki/Profiles.md): node out/mcp.js log.edn
  :mcp {:target :node-script
        :main loretile.mcp/main
        :output-to "out/mcp.js"}}}
