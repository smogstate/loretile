{:ev/id "lc-0001" :ev/ns "loretile-code" :ev/actor "build.py" :ev/ts 1792000000000 :ev/type :profile-set :profile {:id "software" :title "How loretile is built" :brief "The loretile codebase: modules and what they depend on, the features they implement, the events they write, the storage they keep, the gates that verify them, and the rules and decisions that constrain them." :node-types [{:id :module :label "module" :color "#4f7cff" :description "A ClojureScript namespace under src/loretile (or a JS worker under public/js)."} {:id :feature :label "feature" :color "#2fa36b" :description "Something a person can do in the app, or a property it keeps; named in CLAUDE.md and wiki/Code.md."} {:id :event :label "event" :color "#8a63d2" :description "One event type of the log (schema.cljc): the fold builds the graph from these."} {:id :store :label "store" :color "#6b7f99" :description "A localStorage key (or a family of keys) the app reads and writes."} {:id :gate :label "gate" :color "#2aa7b8" :description "A test: fold_test, a browser check test/<name>-check.js, or a Makefile target."} {:id :rule :label "rule" :color "#d9822b" :description "A rule an edit can break, from CLAUDE.md «Rules an edit can break»."} {:id :decision :label "decision" :color "#c94f7c" :description "A decision page or section of the wiki that says why something is so."}] :relations [{:id :depends-on :label "depends on" :inverse "used by" :from #{:module} :to #{:module} :ordering? true :description "A → B: module A requires module B (its ns :require). B is built first."} {:id :implements :label "implements" :inverse "implemented in" :from #{:module} :to #{:feature} :description "module → feature: the module holds the code of the feature."} {:id :emits :label "emits" :inverse "emitted by" :from #{:module} :to #{:event} :description "module → event: the module appends events of this type to the log."} {:id :stores-in :label "keeps state in" :inverse "state of" :from #{:module} :to #{:store} :description "module → store: the module reads or writes this storage key."} {:id :verifies :label "verifies" :inverse "verified by" :from #{:gate} :to #{:feature} :description "gate → feature: the test fails when the feature breaks."} {:id :constrains :label "constrains" :inverse "constrained by" :from #{:rule} :to #{:feature :module} :description "rule → feature or module: an edit there must keep the rule."} {:id :decided-in :label "decided in" :inverse "decides" :from #{:feature :rule} :to #{:decision} :description "feature or rule → decision: the wiki page that says why."} {:id :within :label "is within" :inverse "includes" :from #{:feature} :to #{:feature} :acyclic? true :description "A → B: feature A is part of the larger feature B."}]}}
