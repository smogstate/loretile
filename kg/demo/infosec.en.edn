{:ev/id "inf-042" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757002520000 :ev/type :change :ops [[:node-set "o-inf-data-classes-13" {:concept-id "data-classes" :kind :explanation :level :apprentice :locale "en" :origin :authored :text "Four classes, four homes. Public — anywhere; internal — corporate systems; confidential — cleared people only; personal — registered systems and a legal basis only." :grounded-in "src-policy" :anchor "p19" :is :object}]]}
