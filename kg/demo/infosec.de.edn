{:ev/id "inf-001" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757000060000 :ev/type :change :ops [[:node-set "src-memo" {:title "Merkblatt für neue Mitarbeitende" :ref "newcomer-memo.pdf" :is :source}]]}
{:ev/id "inf-002" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757000120000 :ev/type :change :ops [[:node-set "passwords" {:title "Starke Passwörter und Passphrasen" :definition "Länge schlägt Komplexität: eine Phrase aus vier zufälligen Wörtern ist stärker als P@ssw0rd. Ein Dienst, ein Passwort — Wiederverwendung macht aus einem Leck zehn." :kind :procedure :source-id "src-policy" :status :accepted}]]}
{:ev/id "inf-003" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757000180000 :ev/type :change :ops [[:node-set "password-manager" {:title "Passwort-Manager" :definition "Verwahrt einzigartige Passwörter für Sie; Sie merken sich nur die Master-Phrase. Der Firmen-Manager ist der einzige zugelassene Ort für Arbeitspasswörter." :kind :procedure :source-id "src-policy" :status :accepted}]]}
{:ev/id "inf-004" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757000240000 :ev/type :change :ops [[:node-set "mfa" {:title "Zwei-Faktor-Authentifizierung (2FA)" :definition "Der zweite Faktor ist etwas, das Sie HABEN (App, Schlüssel), zusätzlich zu etwas, das Sie WISSEN. Ein gestohlenes Passwort ist ohne ihn nutzlos." :kind :principle :source-id "src-policy" :status :accepted}]]}
{:ev/id "inf-005" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757000300000 :ev/type :change :ops [[:node-set "social-engineering" {:title "Social Engineering" :definition "Ein Angriff auf den Menschen, nicht auf die Technik: Dringlichkeit, Autorität und Angst schalten die Prüfung aus. Jedes „dringend, sagen Sie es niemandem“ ist das Signal anzuhalten." :kind :principle :source-id "src-memo" :status :accepted}]]}
{:ev/id "inf-006" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757000360000 :ev/type :change :ops [[:node-set "phishing" {:title "Phishing" :definition "Eine Nachricht, die einen vertrauten Absender vortäuscht, um ein Passwort abzugreifen oder einen Anhang öffnen zu lassen. Prüfen Sie Absenderadresse und Link-Domain, nicht den Wortlaut." :kind :definition :source-id "src-policy" :status :accepted}]]}
{:ev/id "inf-007" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757000420000 :ev/type :change :ops [[:node-set "attachments" {:title "Links und Anhänge" :definition "Erst zeigen, dann klicken: die echte Adresse erscheint unten. Ein unerwarteter Anhang — auch „von einer Kollegin“ — wird zuerst über einen anderen Kanal bestätigt." :kind :procedure :source-id "src-memo" :status :accepted}]]}
{:ev/id "inf-008" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757000480000 :ev/type :change :ops [[:node-set "updates" {:title "Software-Updates" :definition "Updates schließen bekannte Lücken; ein aufgeschobenes Update ist eine offene Tür mit veröffentlichtem Bauplan des Schlosses. Auto-Update ist an — lassen Sie es an." :kind :procedure :source-id "src-policy" :status :accepted}]]}
{:ev/id "inf-009" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757000540000 :ev/type :change :ops [[:node-set "device-lock" {:title "Gerätesperre und Verschlüsselung" :definition "Der Bildschirm sperrt sich nach 5 Minuten selbst — beim Aufstehen sperren Sie ihn trotzdem selbst. Die Platte ist verschlüsselt: ein verlorener Laptop kostet Hardware, keine Daten." :kind :procedure :source-id "src-policy" :status :accepted}]]}
{:ev/id "inf-010" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757000600000 :ev/type :change :ops [[:node-set "public-wifi" {:title "Öffentliches WLAN und VPN" :definition "Im Café oder Flughafen sieht das Netz Ihren Verkehr. Arbeitssysteme nur über das Firmen-VPN; ohne VPN nur, was alle sehen dürften." :kind :procedure :source-id "src-memo" :status :accepted}]]}
{:ev/id "inf-011" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757000660000 :ev/type :change :ops [[:node-set "data-classes" {:title "Datenklassifizierung" :definition "Öffentlich, intern, vertraulich, personenbezogen — die Klasse bestimmt, wo Daten liegen dürfen und wer sie sehen darf. Im Zweifel gilt: vertraulich." :kind :definition :source-id "src-policy" :status :accepted}]]}
{:ev/id "inf-012" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757000720000 :ev/type :change :ops [[:node-set "personal-data" {:title "Umgang mit personenbezogenen Daten" :definition "Ein Name mit Telefonnummer ist bereits personenbezogen. Minimum erheben, nur in registrierten Systemen speichern, nie an Messenger oder private Mail weiterleiten." :kind :procedure :source-id "src-policy" :status :accepted}]]}
{:ev/id "inf-013" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757000780000 :ev/type :change :ops [[:node-set "incident" {:title "Vorfallsmeldung" :definition "Auf Phishing geklickt — melden Sie es in den ersten 10 Minuten: Passwortwechsel und Sitzungs-Widerruf überholen den Angreifer. Wer meldet, wird nicht bestraft; Schweigen schon." :kind :procedure :source-id "src-memo" :status :accepted}]]}
{:ev/id "inf-014" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757000840000 :ev/type :change :ops [[:node-set "backups" {:title "Datensicherung" :definition "Arbeitsdateien liegen in synchronisierten Ordnern — die sichert die Firma. Eine Datei nur auf dem Desktop existiert nicht: ein verschütteter Kaffee, und sie ist weg." :kind :procedure :source-id "src-memo" :status :accepted}]]}
{:ev/id "inf-015" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757000900000 :ev/type :change :ops [[:node-set "clean-desk" {:title "Clean Desk und Bildschirm" :definition "Vertrauliche Ausdrucke in den Schredder, nicht in den Papierkorb; ein Passwort auf einem Zettel ist ein Geschenk an jeden Bürogast. Wischen Sie das Whiteboard nach dem Termin ab." :kind :procedure :source-id "src-policy" :status :accepted}]]}
