{:ev/id "vin-002" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757100120000 :ev/type :change :ops [[:node-set "vine-anatomy" {:title "Строение куста" :definition "Штамб несёт рукава, рукава — плодовые лозы, на лозах — глазки, из которых растут зелёные побеги. Урожай этого года рождается из глазков прошлогодней лозы." :kind :definition :source-id "src-handbook" :status :accepted}]]}
{:ev/id "vin-003" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757100180000 :ev/type :change :ops [[:node-set "rootstock" {:title "Подвой и прививка" :definition "Европейский сорт прививают на американский подвой — его корни не по зубам филлоксере. Подвой выбирают под почву: известь, засуху, засоление." :kind :definition :source-id "src-handbook" :status :accepted}]]}
{:ev/id "vin-004" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757100240000 :ev/type :change :ops [[:node-set "terroir" {:title "Терруар" :definition "Сумма места: почва, рельеф, климат и рука хозяйства. Один сорт на двух склонах даёт два разных вина — это терруар, а не ошибка винодела." :kind :principle :source-id "src-handbook" :status :accepted}]]}
{:ev/id "vin-005" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757100300000 :ev/type :change :ops [[:node-set "soil" {:title "Почва виноградника" :definition "Лоза любит бедные, дренированные почвы: на жирном чернозёме она гонит листья вместо гроздей. Камень днём греется — ночью отдаёт тепло ягоде." :kind :definition :source-id "src-handbook" :status :accepted}]]}
{:ev/id "vin-006" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757100360000 :ev/type :change :ops [[:node-set "climate" {:title "Климат и микроклимат" :definition "Макроклимат — регион, мезоклимат — склон, микроклимат — воздух внутри кроны. Виноградарь управляет только последним: листьями, рядами, травой в междурядье." :kind :definition :source-id "src-handbook" :status :accepted}]]}
{:ev/id "vin-007" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757100420000 :ev/type :change :ops [[:node-set "phenology" {:title "Фазы вегетации" :definition "Плач лозы, распускание почек, цветение, завязь, рост ягоды, верезон, созревание, листопад. Каждая операция в сезоне привязана к фазе, а не к дате." :kind :definition :source-id "src-handbook" :status :accepted}]]}
{:ev/id "vin-008" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757100480000 :ev/type :change :ops [[:node-set "trellis" {:title "Шпалера и формировка" :definition "Шпалера держит крону в вертикальной плоскости: листья на солнце, грозди в полутени, проветривание сверху донизу. Формировка — скелет куста, который шпалера несёт." :kind :definition :source-id "src-handbook" :status :accepted}]]}
{:ev/id "vin-009" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757100540000 :ev/type :change :ops [[:node-set "winter-pruning" {:title "Зимняя обрезка" :definition "Обрезка решает урожай будущего года: оставить мало глазков — недобор, много — перегруз и мелкая ягода. Считают глазки на куст, а не лозы." :kind :procedure :source-id "src-handbook" :status :accepted}]]}
{:ev/id "vin-010" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757100600000 :ev/type :change :ops [[:node-set "canopy" {:title "Зелёные операции" :definition "Обломка волчков, подвязка, чеканка верхушек, удаление листьев у гроздей. Цель одна: свет и воздух ягоде, силы куста — в урожай, а не в ботву." :kind :procedure :source-id "src-notes" :status :accepted}]]}
{:ev/id "vin-011" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757100660000 :ev/type :change :ops [[:node-set "veraison" {:title "Верезон" :definition "Начало созревания: красные сорта окрашиваются, белые становятся полупрозрачными, ягода мягчеет. Рост окончен — сахар пошёл вверх, кислота вниз." :kind :definition :source-id "src-handbook" :status :accepted}]]}
{:ev/id "vin-012" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757100720000 :ev/type :change :ops [[:node-set "ripeness" {:title "Зрелость: сахар и кислота" :definition "Зрелость — это баланс: сахар в °Bx растёт, титруемая кислотность в г/л падает. Для игристого снимают раньше, для десертного — позже; «спелая на вкус» ягода — не аргумент без цифр." :kind :principle :source-id "src-notes" :status :accepted}]]}
{:ev/id "vin-013" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757100780000 :ev/type :change :ops [[:node-set "harvest" {:title "Сбор урожая" :definition "Дату диктуют цифры зрелости и прогноз: дождь перед сбором разбавляет сок и рвёт ягоду. Собирают утром, по холодку — тёплая ягода окисляется по дороге." :kind :procedure :source-id "src-notes" :status :accepted}]]}
{:ev/id "vin-014" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757100840000 :ev/type :change :ops [[:node-set "mildew" {:title "Милдью и оидиум" :definition "Милдью — ложная мучнистая роса: маслянистые пятна сверху листа, белый пушок снизу, любит влагу. Оидиум — настоящая: серый налёт «пылью» по обеим сторонам и по ягоде, работает и в сушь." :kind :definition :source-id "src-handbook" :status :accepted}]]}
{:ev/id "vin-015" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757100900000 :ev/type :change :ops [[:node-set "irrigation" {:title "Полив" :definition "Умеренный дефицит воды до верезона — союзник качества: ягода мельче, вкус плотнее. Поливать перед сбором — разбавлять будущее вино." :kind :procedure :source-id "src-notes" :status :accepted}]]}
