{:ev/id "vin-001" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757100060000 :ev/type :change :ops [[:node-set "src-notes" {:title "Feldnotizen des Agronomen" :ref "field-notes.pdf" :is :source}]]}
{:ev/id "vin-002" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757100120000 :ev/type :change :ops [[:node-set "vine-anatomy" {:title "Aufbau des Rebstocks" :definition "Der Stamm trägt die Kordons, die Kordons die Fruchtruten, die Ruten die Augen, aus denen die grünen Triebe wachsen. Die Ernte dieses Jahres entsteht aus den Augen der vorjährigen Rute." :kind :definition :source-id "src-handbook" :status :accepted}]]}
{:ev/id "vin-003" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757100180000 :ev/type :change :ops [[:node-set "rootstock" {:title "Unterlage und Veredelung" :definition "Eine europäische Sorte wird auf eine amerikanische Unterlage veredelt — deren Wurzeln kann die Reblaus nichts anhaben. Die Unterlage wählt man nach dem Boden: Kalk, Trockenheit, Versalzung." :kind :definition :source-id "src-handbook" :status :accepted}]]}
{:ev/id "vin-004" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757100240000 :ev/type :change :ops [[:node-set "terroir" {:title "Terroir" :definition "Die Summe eines Ortes: Boden, Relief, Klima und die Hand des Betriebs. Eine Sorte an zwei Hängen ergibt zwei verschiedene Weine — das ist Terroir, kein Fehler des Winzers." :kind :principle :source-id "src-handbook" :status :accepted}]]}
{:ev/id "vin-005" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757100300000 :ev/type :change :ops [[:node-set "soil" {:title "Weinbergsboden" :definition "Die Rebe liebt karge, durchlässige Böden: auf fetter Schwarzerde treibt sie Blätter statt Trauben. Steine erwärmen sich tags und geben die Wärme nachts an die Beeren ab." :kind :definition :source-id "src-handbook" :status :accepted}]]}
{:ev/id "vin-006" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757100360000 :ev/type :change :ops [[:node-set "climate" {:title "Klima und Mikroklima" :definition "Makroklima ist die Region, Mesoklima der Hang, Mikroklima die Luft in der Laubwand. Der Winzer steuert nur das letzte: Blätter, Zeilen, das Gras der Fahrgasse." :kind :definition :source-id "src-handbook" :status :accepted}]]}
{:ev/id "vin-007" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757100420000 :ev/type :change :ops [[:node-set "phenology" {:title "Entwicklungsstadien" :definition "Bluten, Austrieb, Blüte, Fruchtansatz, Beerenwachstum, Véraison, Reife, Laubfall. Jede Arbeit der Saison hängt am Stadium, nicht am Datum." :kind :definition :source-id "src-handbook" :status :accepted}]]}
{:ev/id "vin-008" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757100480000 :ev/type :change :ops [[:node-set "trellis" {:title "Spalier und Reberziehung" :definition "Das Spalier hält die Laubwand in einer senkrechten Ebene: Blätter in der Sonne, Trauben im Halbschatten, Durchlüftung von oben bis unten. Die Erziehung ist das Gerüst, das das Spalier trägt." :kind :definition :source-id "src-handbook" :status :accepted}]]}
{:ev/id "vin-009" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757100540000 :ev/type :change :ops [[:node-set "winter-pruning" {:title "Rebschnitt" :definition "Der Rebschnitt entscheidet die nächste Ernte: zu wenige Augen — Mindermenge, zu viele — Überlast und kleine Beeren. Gezählt werden Augen pro Stock, nicht Ruten." :kind :procedure :source-id "src-handbook" :status :accepted}]]}
{:ev/id "vin-010" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757100600000 :ev/type :change :ops [[:node-set "canopy" {:title "Laubarbeit" :definition "Ausbrechen der Wasserschosser, Heften, Gipfeln, Entblättern der Traubenzone. Ein Ziel: Licht und Luft für die Beeren, die Kraft des Stocks in die Frucht, nicht ins Laub." :kind :procedure :source-id "src-notes" :status :accepted}]]}
{:ev/id "vin-011" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757100660000 :ev/type :change :ops [[:node-set "veraison" {:title "Véraison" :definition "Der Reifebeginn: rote Sorten färben sich, weiße werden durchscheinend, die Beere wird weich. Das Wachstum ist vorbei — Zucker steigt, Säure fällt." :kind :definition :source-id "src-handbook" :status :accepted}]]}
{:ev/id "vin-012" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757100720000 :ev/type :change :ops [[:node-set "ripeness" {:title "Reife: Zucker und Säure" :definition "Reife ist eine Balance: der Zucker in °Oechsle steigt, die titrierbare Säure in g/L fällt. Für Sekt liest man früher, für Süßwein später; eine Beere, die „reif schmeckt“, zählt ohne Zahlen nicht." :kind :principle :source-id "src-notes" :status :accepted}]]}
{:ev/id "vin-013" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757100780000 :ev/type :change :ops [[:node-set "harvest" {:title "Weinlese" :definition "Das Datum diktieren die Reifezahlen und die Vorhersage: Regen vor der Lese verwässert den Most und lässt Beeren platzen. Gelesen wird morgens in der Kühle — warmes Lesegut oxidiert unterwegs." :kind :procedure :source-id "src-notes" :status :accepted}]]}
{:ev/id "vin-014" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757100840000 :ev/type :change :ops [[:node-set "mildew" {:title "Falscher und echter Mehltau" :definition "Falscher Mehltau: ölige Flecken oben am Blatt, weißer Flaum darunter, liebt Nässe. Echter Mehltau: grauer, staubartiger Belag beidseitig und auf der Beere, arbeitet auch bei Trockenheit." :kind :definition :source-id "src-handbook" :status :accepted}]]}
{:ev/id "vin-015" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1757100900000 :ev/type :change :ops [[:node-set "irrigation" {:title "Bewässerung" :definition "Ein leichtes Wasserdefizit vor der Véraison ist ein Verbündeter der Qualität: kleinere Beeren, dichterer Geschmack. Bewässern vor der Lese verdünnt den künftigen Wein." :kind :procedure :source-id "src-notes" :status :accepted}]]}
