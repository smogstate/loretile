{:ev/id "demo-002" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756800120000 :ev/type :change :ops [[:node-set "tables" {:title "Tables, rows and columns" :definition "A relational table: named, typed columns and rows with no inherent order. A query describes WHAT you want, not how to get it." :kind :definition :source-id "src-sql-book" :status :accepted}]]}
{:ev/id "demo-003" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756800180000 :ev/type :change :ops [[:node-set "select" {:title "SELECT: choosing columns" :definition "SELECT lists the columns of the result; FROM names the table. The star grabs every column — handy at the console, bad in a report." :kind :procedure :source-id "src-sql-book" :status :accepted}]]}
{:ev/id "demo-004" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756800240000 :ev/type :change :ops [[:node-set "operators" {:title "Comparison operators and AND/OR logic" :definition "=, <>, <, >, BETWEEN, IN, LIKE, combined with AND, OR, NOT. AND binds tighter than OR — without parentheses a condition reads differently than it was written." :kind :principle :source-id "src-sql-book" :status :accepted}]]}
{:ev/id "demo-005" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756800300000 :ev/type :change :ops [[:node-set "where" {:title "Filtering with WHERE" :definition "WHERE keeps the rows for which the condition is true. It runs BEFORE grouping — aggregates can't appear in it." :kind :procedure :source-id "src-sql-book" :status :accepted}]]}
{:ev/id "demo-006" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756800360000 :ev/type :change :ops [[:node-set "order-by" {:title "Sorting with ORDER BY" :definition "ORDER BY sets the order of the result rows; without it the order isn't guaranteed. Multiple keys, ASC/DESC for each." :kind :procedure :source-id "src-sql-book" :status :accepted}]]}
{:ev/id "demo-007" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756800420000 :ev/type :change :ops [[:node-set "limit" {:title "LIMIT and pagination" :definition "LIMIT n OFFSET m cuts a window out of the sorted result. Without ORDER BY, the window is arbitrary." :kind :procedure :source-id "src-pg-docs" :status :accepted}]]}
{:ev/id "demo-008" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756800480000 :ev/type :change :ops [[:node-set "distinct" {:title "DISTINCT: unique values" :definition "DISTINCT removes duplicate result rows as a whole — across all listed columns, not just the first one." :kind :procedure :source-id "src-sql-book" :status :accepted}]]}
{:ev/id "demo-009" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756800540000 :ev/type :change :ops [[:node-set "null" {:title "NULL and three-valued logic" :definition "NULL isn't a value — it's the absence of one. Any comparison with NULL yields UNKNOWN; you test it with IS NULL, not = NULL." :kind :principle :source-id "src-sql-book" :status :accepted}]]}
{:ev/id "demo-010" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756800600000 :ev/type :change :ops [[:node-set "agg" {:title "Aggregate functions: COUNT, SUM, AVG" :definition "An aggregate collapses many rows into one value. COUNT(*) counts rows, COUNT(col) counts non-NULL values; AVG ignores NULL." :kind :definition :source-id "src-sql-book" :status :accepted}]]}
{:ev/id "demo-011" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756800660000 :ev/type :change :ops [[:node-set "group-by" {:title "GROUP BY: grouping" :definition "GROUP BY sorts rows into buckets by column values; each bucket produces one result row. Anything not in GROUP BY has to sit under an aggregate." :kind :procedure :source-id "src-sql-book" :status :accepted}]]}
{:ev/id "demo-012" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756800720000 :ev/type :change :ops [[:node-set "having" {:title "HAVING: filtering groups" :definition "HAVING picks buckets after grouping — aggregates are allowed in it. A condition on rows goes in WHERE, a condition on groups goes in HAVING." :kind :procedure :source-id "src-sql-book" :status :accepted}]]}
{:ev/id "demo-013" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756800780000 :ev/type :change :ops [[:node-set "keys" {:title "Keys and table relationships" :definition "A primary key identifies a row uniquely; a foreign key points to the primary key of another table. Tables are joined on these pairs." :kind :definition :source-id "src-sql-book" :status :accepted}]]}
{:ev/id "demo-014" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756800840000 :ev/type :change :ops [[:node-set "join" {:title "JOIN: joining tables" :definition "INNER JOIN glues rows of two tables together on the ON condition and keeps only the pairs where it holds. Without a condition you get a Cartesian product." :kind :procedure :source-id "src-sql-book" :status :accepted}]]}
{:ev/id "demo-015" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756800900000 :ev/type :change :ops [[:node-set "left-join" {:title "LEFT JOIN and missing rows" :definition "LEFT JOIN keeps every row of the left table; where there's no match, the right table's columns come back NULL. A filter on the right table in WHERE turns LEFT into INNER." :kind :procedure :source-id "src-pg-docs" :status :accepted}]]}
{:ev/id "demo-016" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756800960000 :ev/type :change :ops [[:node-set "subquery" {:title "Subqueries" :definition "A query inside a query: in WHERE (IN, EXISTS), in FROM (a derived table) or in SELECT (a scalar subquery). A correlated subquery runs once per outer row." :kind :procedure :source-id "src-sql-book" :status :accepted}]]}
{:ev/id "demo-017" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756801020000 :ev/type :change :ops [[:node-set "cte" {:title "CTEs: the WITH clause" :definition "WITH names a subquery and pulls it up to the top; the query then reads top to bottom, like a recipe. Recursive CTEs walk hierarchies." :kind :procedure :source-id "src-pg-docs" :status :accepted}]]}
{:ev/id "demo-018" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756801080000 :ev/type :change :ops [[:node-set "window" {:title "Window functions" :definition "A window function computes an aggregate over a \"window\" of rows without collapsing them: ROW_NUMBER, RANK, SUM OVER (PARTITION BY … ORDER BY …). The row count stays the same." :kind :principle :source-id "src-pg-docs" :status :accepted}]]}
