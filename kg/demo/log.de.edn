{:ev/id "demo-150" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756809000000 :ev/type :change :ops [[:node-set "i-join-4" {:primary-concept-id "join" :level :apprentice :kind :exercise :locale "de" :spec {:stem "Geben Sie den Kundennamen und den Betrag jeder seiner Bestellungen aus." :setup "create table customers (id int primary key, name text, city text);\ncreate table orders (id int primary key, customer_id int references customers, amount numeric, placed date);\ninsert into customers values (1,'Anna','Moscow'),(2,'Boris','Kazan'),(3,'Vera','Moscow'),(4,'Gleb','Sochi'),(5,'Dina','Kazan');\ninsert into orders values (1,1,120,'2026-01-03'),(2,1,80,'2026-02-11'),(3,2,300,'2026-01-20'),\n  (4,3,50,'2026-03-01'),(5,3,70,'2026-03-15'),(6,3,90,'2026-04-02'),(7,4,10,'2026-02-02');" :solution "SELECT c.name, o.amount FROM orders o JOIN customers c ON c.id = o.customer_id" :schema "customers(id, name, city)\norders(id, customer_id, amount, placed)" :ordered? false} :is :item}]]}
