{:ev/id "demo-148" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756808880000 :ev/type :change :ops [[:node-set "i-group-by-4" {:primary-concept-id "group-by" :level :apprentice :kind :exercise :locale "de" :spec {:stem "Summieren Sie die Bestellungen jedes Kunden: customer_id und die Summe." :setup "create table customers (id int primary key, name text, city text);\ncreate table orders (id int primary key, customer_id int references customers, amount numeric, placed date);\ninsert into customers values (1,'Anna','Moscow'),(2,'Boris','Kazan'),(3,'Vera','Moscow'),(4,'Gleb','Sochi'),(5,'Dina','Kazan');\ninsert into orders values (1,1,120,'2026-01-03'),(2,1,80,'2026-02-11'),(3,2,300,'2026-01-20'),\n  (4,3,50,'2026-03-01'),(5,3,70,'2026-03-15'),(6,3,90,'2026-04-02'),(7,4,10,'2026-02-02');" :solution "SELECT customer_id, SUM(amount) FROM orders GROUP BY customer_id" :schema "customers(id, name, city)\norders(id, customer_id, amount, placed)" :ordered? false} :is :item}]]}
