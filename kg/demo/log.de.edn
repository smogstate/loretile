{:ev/id "demo-001" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756800060000 :ev/type :change :ops [[:node-set "src-pg-docs" {:title "PostgreSQL-16-Dokumentation — Queries" :ref "https://www.postgresql.org/docs/16/queries.html" :is :source}]]}
{:ev/id "demo-002" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756800120000 :ev/type :change :ops [[:node-set "tables" {:title "Tabellen, Zeilen und Spalten" :definition "Eine relationale Tabelle: benannte, typisierte Spalten und Zeilen ohne feste Reihenfolge. Eine Abfrage beschreibt, WAS man haben will, nicht wie." :kind :definition :source-id "src-sql-book" :status :accepted}]]}
{:ev/id "demo-003" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756800180000 :ev/type :change :ops [[:node-set "select" {:title "SELECT: Spalten auswählen" :definition "SELECT listet die Spalten des Ergebnisses auf; FROM nennt die Tabelle. Der Stern nimmt alle Spalten — praktisch in der Konsole, schlecht im Bericht." :kind :procedure :source-id "src-sql-book" :status :accepted}]]}
{:ev/id "demo-004" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756800240000 :ev/type :change :ops [[:node-set "operators" {:title "Vergleichsoperatoren und AND/OR-Logik" :definition "=, <>, <, >, BETWEEN, IN, LIKE, kombiniert mit AND, OR, NOT. AND bindet stärker als OR — ohne Klammern liest sich die Bedingung anders, als sie geschrieben wurde." :kind :principle :source-id "src-sql-book" :status :accepted}]]}
{:ev/id "demo-005" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756800300000 :ev/type :change :ops [[:node-set "where" {:title "Filtern mit WHERE" :definition "WHERE behält die Zeilen, für die die Bedingung wahr ist. Es läuft VOR der Gruppierung — Aggregate dürfen darin nicht vorkommen." :kind :procedure :source-id "src-sql-book" :status :accepted}]]}
{:ev/id "demo-006" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756800360000 :ev/type :change :ops [[:node-set "order-by" {:title "Sortieren mit ORDER BY" :definition "ORDER BY legt die Reihenfolge der Ergebniszeilen fest; ohne ORDER BY ist die Reihenfolge nicht garantiert. Mehrere Schlüssel, ASC/DESC für jeden." :kind :procedure :source-id "src-sql-book" :status :accepted}]]}
{:ev/id "demo-007" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756800420000 :ev/type :change :ops [[:node-set "limit" {:title "LIMIT und seitenweise Ausgabe" :definition "LIMIT n OFFSET m schneidet ein Fenster aus dem sortierten Ergebnis. Ohne ORDER BY ist das Fenster beliebig." :kind :procedure :source-id "src-pg-docs" :status :accepted}]]}
{:ev/id "demo-008" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756800480000 :ev/type :change :ops [[:node-set "distinct" {:title "DISTINCT: eindeutige Werte" :definition "DISTINCT entfernt doppelte Ergebniszeilen als Ganzes — über alle aufgeführten Spalten, nicht nur die erste." :kind :procedure :source-id "src-sql-book" :status :accepted}]]}
{:ev/id "demo-009" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756800540000 :ev/type :change :ops [[:node-set "null" {:title "NULL und dreiwertige Logik" :definition "NULL ist kein Wert, sondern dessen Fehlen. Jeder Vergleich mit NULL ergibt UNKNOWN; man prüft mit IS NULL, nicht mit = NULL." :kind :principle :source-id "src-sql-book" :status :accepted}]]}
{:ev/id "demo-010" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756800600000 :ev/type :change :ops [[:node-set "agg" {:title "Aggregatfunktionen COUNT, SUM, AVG" :definition "Ein Aggregat verdichtet viele Zeilen zu einem Wert. COUNT(*) zählt Zeilen, COUNT(col) zählt Nicht-NULL-Werte; AVG ignoriert NULL." :kind :definition :source-id "src-sql-book" :status :accepted}]]}
{:ev/id "demo-011" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756800660000 :ev/type :change :ops [[:node-set "group-by" {:title "GROUP BY: Gruppierung" :definition "GROUP BY verteilt Zeilen anhand von Spaltenwerten auf Körbe; jeder Korb ergibt eine Ergebniszeile. Alles, was nicht in GROUP BY steht, muss unter einem Aggregat stehen." :kind :procedure :source-id "src-sql-book" :status :accepted}]]}
{:ev/id "demo-012" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756800720000 :ev/type :change :ops [[:node-set "having" {:title "HAVING: Filtern nach Gruppen" :definition "HAVING wählt Körbe nach der Gruppierung aus — darin dürfen Aggregate stehen. Eine Bedingung für Zeilen gehört in WHERE, eine Bedingung für Gruppen in HAVING." :kind :procedure :source-id "src-sql-book" :status :accepted}]]}
{:ev/id "demo-013" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756800780000 :ev/type :change :ops [[:node-set "keys" {:title "Schlüssel und Tabellenbeziehungen" :definition "Ein Primärschlüssel identifiziert eine Zeile eindeutig; ein Fremdschlüssel verweist auf den Primärschlüssel einer anderen Tabelle. Über diese Paare werden Tabellen verbunden." :kind :definition :source-id "src-sql-book" :status :accepted}]]}
{:ev/id "demo-014" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756800840000 :ev/type :change :ops [[:node-set "join" {:title "JOIN: Tabellen verbinden" :definition "INNER JOIN verbindet Zeilen zweier Tabellen über die ON-Bedingung und behält nur die Paare, für die sie zutrifft. Ohne Bedingung entsteht ein kartesisches Produkt." :kind :procedure :source-id "src-sql-book" :status :accepted}]]}
{:ev/id "demo-015" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756800900000 :ev/type :change :ops [[:node-set "left-join" {:title "LEFT JOIN und fehlende Zeilen" :definition "LEFT JOIN behält jede Zeile der linken Tabelle; wo es keine Übereinstimmung gibt, werden die Spalten der rechten Tabelle NULL. Ein Filter auf die rechte Tabelle in WHERE macht aus LEFT ein INNER." :kind :procedure :source-id "src-pg-docs" :status :accepted}]]}
{:ev/id "demo-016" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756800960000 :ev/type :change :ops [[:node-set "subquery" {:title "Unterabfragen" :definition "Eine Abfrage innerhalb einer Abfrage: in WHERE (IN, EXISTS), in FROM (abgeleitete Tabelle) oder in SELECT (skalar). Eine korrelierte Unterabfrage läuft für jede äußere Zeile einmal." :kind :procedure :source-id "src-sql-book" :status :accepted}]]}
{:ev/id "demo-017" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756801020000 :ev/type :change :ops [[:node-set "cte" {:title "CTEs: die WITH-Klausel" :definition "WITH gibt einer Unterabfrage einen Namen und zieht sie nach oben; die Abfrage liest sich dann von oben nach unten wie ein Rezept. Rekursive CTEs durchlaufen Hierarchien." :kind :procedure :source-id "src-pg-docs" :status :accepted}]]}
{:ev/id "demo-018" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756801080000 :ev/type :change :ops [[:node-set "window" {:title "Fensterfunktionen" :definition "Eine Fensterfunktion berechnet ein Aggregat über ein „Fenster“ von Zeilen, ohne sie zu verdichten: ROW_NUMBER, RANK, SUM OVER (PARTITION BY … ORDER BY …). Die Zeilenzahl bleibt gleich." :kind :principle :source-id "src-pg-docs" :status :accepted}]]}
