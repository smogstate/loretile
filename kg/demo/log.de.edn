{:ev/id "demo-042" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756802520000 :ev/type :change :ops [[:node-set "o-select-0" {:concept-id "select" :kind :explanation :level :novice :locale "de" :origin :authored :text "Eine Abfrage liest man ab FROM: zuerst woher, dann was. SELECT name, city FROM customers — zwei Spalten aus der Tabelle customers." :grounded-in "src-sql-book" :anchor "p12" :is :object}]]}
{:ev/id "demo-043" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756802580000 :ev/type :change :ops [[:node-set "o-select-1" {:concept-id "select" :kind :worked-example :level :apprentice :locale "de" :origin :authored :text "Aufgabe: Liste der E-Mail-Adressen von Kunden aus Moskau. Lösung: SELECT email FROM customers WHERE city = 'Moskau'. Anfängerfehler: SELECT * und danach in Excel filtern." :grounded-in "src-sql-book" :anchor "p14" :is :object}]]}
{:ev/id "demo-044" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756802640000 :ev/type :change :ops [[:node-set "o-where-2" {:concept-id "where" :kind :explanation :level :apprentice :locale "de" :origin :authored :text "WHERE ist ein Sieb für Zeilen. Die Bedingung wird für jede Zeile ausgewertet; eine Zeile kommt durch, wenn die Bedingung wahr ist. NULL in der Bedingung — die Zeile kommt nicht durch." :grounded-in "src-sql-book" :anchor "p21" :is :object}]]}
{:ev/id "demo-045" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756802700000 :ev/type :change :ops [[:node-set "o-where-3" {:concept-id "where" :kind :worked-example :level :apprentice :locale "de" :origin :authored :text "Bestellungen aus dem März über 1000: WHERE order_date BETWEEN '2025-03-01' AND '2025-03-31' AND amount > 1000. Klammern sind hier nicht nötig — nur AND." :grounded-in "src-sql-book" :anchor "p23" :is :object}]]}
{:ev/id "demo-046" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756802760000 :ev/type :change :ops [[:node-set "o-operators-4" {:concept-id "operators" :kind :explanation :level :apprentice :locale "de" :origin :authored :text "AND bindet stärker als OR: a OR b AND c liest sich als a OR (b AND c). Setzen Sie immer Klammern, sobald OR im Spiel ist." :grounded-in "src-sql-book" :anchor "p18" :is :object}]]}
{:ev/id "demo-047" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756802820000 :ev/type :change :ops [[:node-set "o-order-by-5" {:concept-id "order-by" :kind :explanation :level :novice :locale "de" :origin :authored :text "ORDER BY amount DESC, created_at — zuerst die teuersten, bei gleichem Betrag die früheren. Sortieren ist der letzte Schritt vor LIMIT." :grounded-in "src-sql-book" :anchor "p30" :is :object}]]}
{:ev/id "demo-048" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756802880000 :ev/type :change :ops [[:node-set "o-null-6" {:concept-id "null" :kind :explanation :level :apprentice :locale "de" :origin :authored :text "WHERE discount = NULL liefert nie irgendein Ergebnis. Richtig: WHERE discount IS NULL. COUNT(discount) zählt die leeren nicht mit." :grounded-in "src-sql-book" :anchor "p26" :is :object}]]}
{:ev/id "demo-049" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756802940000 :ev/type :change :ops [[:node-set "o-agg-7" {:concept-id "agg" :kind :explanation :level :apprentice :locale "de" :origin :authored :text "COUNT(*) — wie viele Zeilen. SUM(amount) — die Summe. AVG(amount) — der Durchschnitt über die Nicht-NULL-Werte. Ohne GROUP BY verdichtet ein Aggregat die ganze Tabelle zu einer Zeile." :grounded-in "src-sql-book" :anchor "p34" :is :object}]]}
{:ev/id "demo-050" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756803000000 :ev/type :change :ops [[:node-set "o-group-by-8" {:concept-id "group-by" :kind :explanation :level :apprentice :locale "de" :origin :authored :text "GROUP BY city verteilt Bestellungen nach Stadt auf Körbe; SELECT city, SUM(amount) ergibt dann eine Zeile pro Stadt. Eine Spalte, die weder aggregiert noch in GROUP BY steht, ist ein Fehler." :grounded-in "src-sql-book" :anchor "p36" :is :object}]]}
{:ev/id "demo-051" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756803060000 :ev/type :change :ops [[:node-set "o-group-by-9" {:concept-id "group-by" :kind :worked-example :level :apprentice :locale "de" :origin :authored :text "Umsatz nach Monat: SELECT date_trunc('month', order_date) AS m, SUM(amount) FROM orders GROUP BY m ORDER BY m." :grounded-in "src-sql-book" :anchor "p38" :is :object}]]}
{:ev/id "demo-052" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756803120000 :ev/type :change :ops [[:node-set "o-group-by-10" {:concept-id "group-by" :kind :diagram :level :apprentice :locale "de" :origin :authored :text "Diagramm: 9 Bestellzeilen → drei Körbe (Moskau, Kasan, Perm) → drei Zeilen mit Summen. Pfeile zeigen, in welchen Korb jede Zeile fällt." :grounded-in "src-sql-book" :anchor "p37" :is :object}]]}
{:ev/id "demo-053" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756803180000 :ev/type :change :ops [[:node-set "o-having-11" {:concept-id "having" :kind :explanation :level :apprentice :locale "de" :origin :authored :text "HAVING COUNT(*) > 10 behält nur die Körbe mit mehr als zehn Bestellungen. Dieselbe Bedingung in WHERE ist ein Syntaxfehler: Die Zeilen sind noch nicht gruppiert." :grounded-in "src-sql-book" :anchor "p40" :is :object}]]}
{:ev/id "demo-054" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756803240000 :ev/type :change :ops [[:node-set "o-having-12" {:concept-id "having" :kind :worked-example :level :apprentice :locale "de" :origin :authored :text "Städte mit einem Umsatz über einer Million im Jahr 2025: WHERE auf das Datum (Zeilen), GROUP BY city, HAVING SUM(amount) > 1000000 (Gruppen)." :grounded-in "src-sql-book" :anchor "p41" :is :object}]]}
{:ev/id "demo-055" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756803300000 :ev/type :change :ops [[:node-set "o-keys-13" {:concept-id "keys" :kind :explanation :level :novice :locale "de" :origin :authored :text "orders.customer_id → customers.id: Eine Bestellung trägt die id ihres Kunden. Genau über solche Paare werden Tabellen verbunden. Ein Schlüssel ist keine „wichtige Spalte“, sondern ein Eindeutigkeitsversprechen." :grounded-in "src-sql-book" :anchor "p46" :is :object}]]}
{:ev/id "demo-056" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756803360000 :ev/type :change :ops [[:node-set "o-join-14" {:concept-id "join" :kind :explanation :level :apprentice :locale "de" :origin :authored :text "FROM orders JOIN customers ON orders.customer_id = customers.id — jeder Bestellung wird ihr Kunde angehängt. Bestellungen ohne Kunden und Kunden ohne Bestellungen fallen weg." :grounded-in "src-sql-book" :anchor "p48" :is :object}]]}
{:ev/id "demo-057" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756803420000 :ev/type :change :ops [[:node-set "o-join-15" {:concept-id "join" :kind :worked-example :level :apprentice :locale "de" :origin :authored :text "Kundenname neben dem Bestellbetrag: SELECT c.name, o.amount FROM orders o JOIN customers c ON o.customer_id = c.id." :grounded-in "src-sql-book" :anchor "p50" :is :object}]]}
{:ev/id "demo-058" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756803480000 :ev/type :change :ops [[:node-set "o-join-16" {:concept-id "join" :kind :diagram :level :apprentice :locale "de" :origin :authored :text "Zwei Tabellen als zwei Spalten von Karten, Linien zwischen übereinstimmenden ids; das Ergebnis sind nur die verbundenen Paare." :grounded-in "src-sql-book" :anchor "p49" :is :object}]]}
{:ev/id "demo-059" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756803540000 :ev/type :change :ops [[:node-set "o-left-join-17" {:concept-id "left-join" :kind :explanation :level :apprentice :locale "de" :origin :authored :text "Kunden ohne Bestellungen: LEFT JOIN orders … WHERE orders.id IS NULL. Schreibt man stattdessen WHERE orders.amount > 0, werden die leeren Zeilen herausgefiltert — aus LEFT wird unbemerkt INNER." :grounded-in "src-pg-docs" :anchor "p52" :is :object}]]}
{:ev/id "demo-060" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756803600000 :ev/type :change :ops [[:node-set "o-subquery-18" {:concept-id "subquery" :kind :explanation :level :apprentice :locale "de" :origin :authored :text "WHERE customer_id IN (SELECT id FROM customers WHERE city = 'Kasan') — die innere Abfrage liefert eine Liste, die äußere filtert damit." :grounded-in "src-sql-book" :anchor "p56" :is :object}]]}
{:ev/id "demo-061" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756803660000 :ev/type :change :ops [[:node-set "o-cte-19" {:concept-id "cte" :kind :explanation :level :apprentice :locale "de" :origin :authored :text "WITH monthly AS (…) SELECT … FROM monthly — zuerst benennt man das Zwischenergebnis, dann nutzt man es wie eine Tabelle. Eine lange Abfrage ist dann keine Matroschka mehr." :grounded-in "src-pg-docs" :anchor "p60" :is :object}]]}
{:ev/id "demo-062" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756803720000 :ev/type :change :ops [[:node-set "o-window-20" {:concept-id "window" :kind :explanation :level :professional :locale "de" :origin :authored :text "SUM(amount) OVER (PARTITION BY city ORDER BY order_date) — eine laufende Summe pro Stadt, wobei jede Bestellzeile an ihrem Platz bleibt." :grounded-in "src-pg-docs" :anchor "p66" :is :object}]]}
{:ev/id "demo-063" :ev/ns "demo" :ev/actor "demo-author" :ev/ts 1756803780000 :ev/type :change :ops [[:node-set "i-select-1" {:primary-concept-id "select" :level :apprentice :kind :single-choice :locale "de" :spec {:stem "Welche Abfrage liefert nur die Namen der Kunden?" :options ["SELECT * FROM customers" "SELECT name FROM customers" "SELECT customers FROM name"] :key 1} :is :item}]]}
